{
  "name": "nooksuite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "tools/*/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "node --test \"tests/unit/**/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "fake-indexeddb": "^6.2.6"
  }
}
