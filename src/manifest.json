{
  "manifest_version": 3,
  "name": "NookBin",
  "version": "0.1",
  "description": "Store documents in the popup and send them to file upload fields on the current page.",
  "permissions": ["scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "NookBin",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
